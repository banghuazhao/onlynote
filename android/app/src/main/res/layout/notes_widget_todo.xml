<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_todo_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="44dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">
    <ImageView android:id="@+id/widget_todo_check"
        android:layout_width="24dp" android:layout_height="24dp"
        android:layout_marginEnd="10dp" android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_circle" />
    <TextView android:id="@+id/widget_todo_title"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textSize="14sp"
        android:maxLines="2" android:ellipsize="end"
        android:textColor="@color/widget_text_primary" />
</LinearLayout>
