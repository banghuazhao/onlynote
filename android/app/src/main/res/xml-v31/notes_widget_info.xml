<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31 added the richer picker metadata: a live preview layout instead of a
  static image, a description line, and cell-based sizing. Kept in a -v31
  variant so the base config stays valid on API 24-30.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:configure="com.appsbay.onlynote.WidgetConfigurationActivity"
    android:initialLayout="@layout/notes_widget"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="180dp"
    android:minWidth="250dp"
    android:previewLayout="@layout/notes_widget_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:widgetCategory="home_screen" />
